# Vertex OS production variables
# Copy this file to .env.local for local reference only.
# Do not commit real values or paste secrets into GitHub.

# PostgreSQL connection string used by Drizzle/SQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Gemini API key used by Vertex AI Copilot.
GEMINI_API_KEY=replace_with_gemini_api_key

# Long random value used to protect application sessions.
SESSION_SECRET=replace_with_a_long_random_session_secret